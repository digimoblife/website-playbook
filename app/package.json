{
  "name": "lapaq-playbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-admin.ts",
    "db:seed:peta": "tsx scripts/seed-peta.ts",
    "admin:reset": "tsx scripts/admin-reset.ts",
    "jadwal:jalankan": "tsx scripts/publish-due.ts",
    "screenshot:jalankan": "tsx --conditions=react-server scripts/screenshot.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.5",
    "playwright-core": "1.56.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "description": "Lapaq Playbook: panduan produk untuk tim marketing dan partner JV",
  "engines": {
    "node": ">=22"
  }
}
