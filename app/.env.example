# Salin berkas ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# Lokasi berkas database SQLite (relatif terhadap folder app/). Boleh dikosongkan.
DATABASE_PATH=data/playbook.db

# Folder gambar unggahan (relatif terhadap folder app/). Boleh dikosongkan. Harus dicadangkan bersama database.
MEDIA_DIR=data/media

# Akun Admin pertama, dipakai HANYA oleh `npm run db:seed`.
# Kata sandi minimal 12 karakter. Hapus ADMIN_PASSWORD dari berkas ini setelah seed berhasil.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kunci enkripsi untuk token GitHub yang diisi dari menu Pengaturan (Langkah 6a). WAJIB bila token
# diisi dari Pengaturan. Buat dengan: openssl rand -base64 32
# Simpan hanya di server dan jangan pernah diganti setelah token disimpan (token lama tidak akan
# bisa dibuka; isi ulang tokennya di Pengaturan bila kunci terpaksa diganti). Satu kunci per instalasi.
SETTINGS_ENCRYPTION_KEY=

# --- Screenshot otomatis (Langkah 6e) ---
# Akun demo untuk skenario yang perlu masuk ke toko demo. Di skenario ditulis ${DEMO_STORE_EMAIL} dan
# ${DEMO_STORE_PASSWORD}; nilainya hanya diambil dari sini dan tidak pernah disimpan di database.
# Hanya variabel berawalan DEMO_STORE_ yang bisa dipakai skenario. Pakai akun demo, bukan akun asli.
DEMO_STORE_EMAIL=
DEMO_STORE_PASSWORD=

# Lokasi Chromium bila tidak memakai `npx playwright install chromium` bawaan. Biasanya kosong.
PLAYWRIGHT_CHROMIUM_PATH=

# --- Cadangan untuk menu Pengaturan ---
# Tiga variabel di bawah hanya dipakai bila kolom yang sama di menu Pengaturan dikosongkan.
# Instalasi baru cukup mengisinya lewat Pengaturan.

# Alamat toko demo, dipakai tombol "Coba di toko demo" di setiap halaman fitur. Opsional: kosong
# berarti tombolnya disembunyikan. Harus URL http:// atau https:// yang sah.
DEMO_STORE_URL=

# Token GitHub hanya-baca, dipakai bila Pengaturan tidak punya token. Buat lewat GitHub Settings >
# Developer settings > Fine-grained tokens, akses read-only ke repo produk saja.
GITHUB_TOKEN=

# Repo produk ("pemilik/repo" atau URL GitHub), dipakai bila Pengaturan tidak berisi repo.
# Kosong di keduanya berarti "Tarik dari GitHub" meminta Admin mengisinya dulu.
GITHUB_REPO=bajaklautmalaka/lapaq

# Rahasia webhook GitHub (Langkah 6c). Isi dengan nilai acak panjang (mis. `openssl rand -hex 32`)
# dan masukkan nilai yang SAMA di GitHub > Settings > Webhooks > Secret. Kosong berarti semua kiriman
# webhook ditolak. Tidak disimpan di database dan tidak diatur dari menu Pengaturan.
GITHUB_WEBHOOK_SECRET=

# --- Langkah 4-experimental: draf AI ---

# Kunci API model AI (Gemini) untuk draf otomatis. Kosong berarti fitur draf AI nonaktif: tombol
# tarik tetap ada tapi menjelaskan bahwa AI belum dikonfigurasi, tidak ada entri yang dibuat.
AI_API_KEY=

# Nama model Gemini yang dipanggil lewat REST API generateContent (mis. gemini-2.0-flash). Cek
# https://ai.google.dev untuk nama model yang berlaku saat ini sebelum mengisi ini — nama model
# berubah dari waktu ke waktu, jangan menebak. Wajib diisi bila AI_API_KEY diisi.
AI_MODEL=gemini-3.5-flash-lite
