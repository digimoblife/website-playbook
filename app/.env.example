# Salin berkas ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# Lokasi berkas database SQLite (relatif terhadap folder app/). Boleh dikosongkan.
DATABASE_PATH=data/playbook.db

# Folder gambar unggahan (relatif terhadap folder app/). Boleh dikosongkan. Harus dicadangkan bersama database.
MEDIA_DIR=data/media

# Akun Admin pertama, dipakai HANYA oleh `npm run db:seed`.
# Kata sandi minimal 12 karakter. Hapus ADMIN_PASSWORD dari berkas ini setelah seed berhasil.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
